<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The companion talks to the Cyclops brain server over the LAN (HTTP). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- COLMI R02 ring: BLE central (scan + connect). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- W7: notification triage. Read-only listener; the wearer grants access
         in system settings, and nothing is stored on the phone. -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    <!-- Phone activity tracking (UsageStats tier): foreground-app sessions
         only, granted by the wearer in system settings, never at runtime. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Cyclops">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".HudMirrorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RemapActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TranscriptActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".WorldActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".FeedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CostActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".DreamsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".EntitiesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ExperiencesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />
        <activity
            android:name=".VisionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- BLE hub: pumps wearable frames into HudBridge, forwards
             display frames back to the device. Started by the app
             with EXTRA_MAC once BLUETOOTH_CONNECT is granted. -->
        <service
            android:name=".CyclopsService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Phone activity tracker: UsageStats foreground sessions -> ledger.
             Started/stopped from Settings (phone_activity pref). -->
        <service
            android:name=".PhoneActivityService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".MemoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".OAuthActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Dev-only config injector for adb-driven test installs. Not exported;
             also self-guards against non-debuggable builds. See ConfigReceiver.kt. -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cyclops.companion.SET_CONFIG" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".HudWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hud_widget_info" />
        </receiver>

        <!-- W7: triages notifications through :core Triage rules; buzz-worthy
             ones reach the wearable OLED, the rest are ledger-only. -->
        <service
            android:name=".CyclopsNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
